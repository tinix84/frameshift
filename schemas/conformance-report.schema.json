{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://frameshift.dev/schemas/conformance-report.schema.json",
  "title": "FrameShift adapter conformance report",
  "description": "Adapter by check by case, so an adapter author reads their own result rather than a flat list of every fixture.",
  "type": "object",
  "required": [
    "schema_version",
    "adapters"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "adapters": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/adapter"
      }
    }
  },
  "additionalProperties": false,
  "$defs": {
    "adapter": {
      "type": "object",
      "required": [
        "name",
        "outcome",
        "checks"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "outcome": {
          "type": "string",
          "description": "uncovered is not a pass: no case exercised this adapter.",
          "enum": [
            "conformant",
            "nonconformant",
            "uncovered"
          ]
        },
        "checks": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/check"
          }
        }
      },
      "additionalProperties": false
    },
    "check": {
      "type": "object",
      "required": [
        "name",
        "outcome",
        "cases"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "outcome": {
          "type": "string",
          "enum": [
            "conformant",
            "nonconformant"
          ]
        },
        "cases": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/case"
          }
        }
      },
      "additionalProperties": false
    },
    "case": {
      "type": "object",
      "required": [
        "id",
        "outcome"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "outcome": {
          "type": "string",
          "enum": [
            "pass",
            "fail"
          ]
        },
        "violations": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false
    }
  }
}
